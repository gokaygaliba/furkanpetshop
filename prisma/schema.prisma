generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String          @id @default(cuid())
  barcode         String          @unique
  name            String
  category        String          @default("Genel")
  unit            String          @default("adet")
  costPrice       Decimal         @default(0) @db.Decimal(12, 2)
  salePrice       Decimal         @default(0) @db.Decimal(12, 2)
  minStock        Int             @default(5)
  targetStockDays Int             @default(21)
  leadTimeDays    Int             @default(3)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  stocks          Stock[]
  sales           Sale[]
  movements       StockMovement[]
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String   @default("STORE")
  createdAt DateTime @default(now())
  stocks    Stock[]
  sales     Sale[]
  movements StockMovement[]
}

model Stock {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@unique([productId, locationId])
}

model Sale {
  id          String   @id @default(cuid())
  productId   String
  locationId  String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  channel     String   @default("STORE")
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
  location    Location @relation(fields: [locationId], references: [id])
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  locationId  String
  quantity    Int
  type        String
  note        String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
  location    Location @relation(fields: [locationId], references: [id])
}
